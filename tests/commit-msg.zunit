#!/usr/bin/env zunit

@setup {
    hook=${testdir:A:h}/etc/git/hooks/commit-msg
    # The hook saves rejected messages under .git, so it must not run in this repo.
    repo=$(mktemp -d)
    git -C "$repo" init --quiet
    cd "$repo"
    msg=$repo/COMMIT_EDITMSG
}

@teardown {
    cd /
    if [[ -n "${repo:-}" ]]; then
        rm -rf "$repo"
    fi
}

# --- Subject ---------------------------------------------------------------

@test 'accepts a conventional subject with scope and body' {
    printf 'feat(auth): add login\n\nExplain why.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts a subject with no body' {
    printf 'fix: correct typo\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts breaking-change bang with and without scope' {
    printf 'feat!: drop old api\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'feat(api)!: drop old api\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'rejects a subject without a type' {
    printf 'Add login\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Invalid commit message format'
}

@test 'rejects an uppercase type' {
    printf 'Feat: add login\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Invalid commit message format'
}

@test 'rejects a scope outside letters, digits and hyphens' {
    printf 'fix(hooks/git): correct path\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Invalid commit message format'
}

@test 'rejects a subject ending in a period' {
    printf 'fix: correct typo.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'must not end with a period'
}

@test 'rejects an uppercase description' {
    printf 'fix: Correct typo\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'must start with lowercase'
}

@test 'accepts a 72-char subject and rejects a 73-char one' {
    printf 'fix: %s\n' "${(l:67::a:)}" >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'fix: %s\n' "${(l:68::a:)}" >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Subject is 73 chars'
}

# --- Body ------------------------------------------------------------------

@test 'rejects a body without a blank line after the subject' {
    printf 'fix: correct typo\nBody glued to subject.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'blank line between subject and body'
}

@test 'accepts a 72-char body line and rejects a 73-char one' {
    printf 'fix: correct typo\n\n%s\n' "${(l:72::a:)}" >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'fix: correct typo\n\n%s\n' "${(l:73::a:)}" >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Body line 3 is 73 chars'
}

@test 'accepts bullet continuations indented exactly 2 spaces' {
    printf 'fix: x\n\nWhy.\n\n- first bullet\n  continues here\n- second bullet\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'rejects an unindented bullet continuation' {
    printf 'fix: x\n\nWhy.\n\n- first bullet\ncontinues here\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'indented exactly 2 spaces'
}

@test 'rejects a bullet continuation indented 3 spaces' {
    printf 'fix: x\n\nWhy.\n\n- first bullet\n   continues here\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'indented exactly 2 spaces'
}

# --- Indentation -----------------------------------------------------------

@test 'rejects an indented body under an unindented subject' {
    printf 'fix: x\n\n Why.\n More.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 3 is indented'
}

@test 'rejects a wholly indented message' {
    printf '  fix: x\n\n  Why.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 1 is indented'
}

@test 'rejects an indented bullet' {
    printf 'fix: x\n\nWhy.\n\n - indented bullet\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 5 is indented'
}

@test 'rejects a tab-indented body line' {
    printf 'fix: x\n\n\tWhy.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 3 is indented'
}

@test 'rejects an indented body line in CRLF input' {
    printf 'fix: x\r\n\r\n  Why.\r\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 3 is indented'
}

@test 'accepts a whitespace-only blank line' {
    printf 'fix: x\n  \nWhy.\n \t \n- a\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'keeps the indentation in a rejected message instead of dedenting it' {
    printf 'fix: x\n\n  Why.\n' >"$msg"
    touch "$repo/.git/COMMIT_MSG_EDITOR"
    run "$hook" "$msg"
    assert $state equals 1
    [[ "$(<$msg)" == $'fix: x\n\n  Why.' ]] || fail "message was rewritten: $(<$msg)"
    [[ "$(<$repo/.git/COMMIT_MSG_SAVED)" == $'fix: x\n\n  Why.' ]] || fail 'saved message lost its indentation'
}

@test 'accepts an indented footer continuation with spaces or a tab' {
    printf 'feat!: x\n\nWhy.\n\nBREAKING CHANGE: a\n  b\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'feat!: x\n\nWhy.\n\nBREAKING CHANGE: a\n\tb\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'rejects an indented line in a paragraph after the footer block' {
    printf 'feat!: x\n\nWhy.\n\nBREAKING CHANGE: a\n\nMore.\n  indented\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 8 is indented'
}

@test 'rejects indentation after a footer-looking line in a middle paragraph' {
    printf 'fix: x\n\nNote: see below\n  indented\n\nMore.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 4 is indented'
}

@test 'rejects indentation when the final paragraph does not open with a footer' {
    printf 'fix: x\n\nWhy.\n\nBody text.\nRefs: #1\n  cont\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 7 is indented'
}

@test 'rejects a tab after the two-space bullet continuation indent' {
    printf 'fix: x\n\nWhy.\n\n- a\n  \tcont\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'indented exactly 2 spaces'
}

@test 'does not treat a bullet that looks like a footer as a footer' {
    printf 'fix: x\n\nWhy.\n\n- #42 handle x\n\tcont\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'indented exactly 2 spaces'
}

@test 'still skips indented bodies under merge, fixup and squash subjects' {
    printf "Merge branch 'x'\n\n* branch 'x':\n  feat: y\n" >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'fixup! feat: x\n\n  indented\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'Squash commit -- not updating HEAD\n\ncommit abc\nAuthor: A\n\n    msg\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

# --- Body structure --------------------------------------------------------

@test 'rejects a second prose paragraph' {
    printf 'fix: x\n\nWhy.\n\nMore context.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 5 starts a second prose paragraph'
}

@test 'rejects prose containing a colon or hash as a second paragraph' {
    printf 'fix: x\n\nWhy.\n\nThe cause was simple: a typo\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'second prose paragraph'
    printf 'fix: x\n\nWhy.\n\nFixed in PR #12 later\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'second prose paragraph'
}

@test 'accepts several bullet paragraphs after the prose paragraph' {
    printf 'fix: x\n\nWhy.\n\n- a\n- b\n\n- c: with colon\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts bullets followed by a footer' {
    printf 'fix: x\n\nWhy.\n\n- a\n  continues\n\nRefs: #1\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'rejects a body that opens with bullets' {
    printf 'fix: x\n\n- a\n- b\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 3 starts with bullets'
}

@test 'rejects a body that opens with bullets after a blank run' {
    printf 'fix: x\n\n\n- a\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 4 starts with bullets'
}

@test 'rejects bullets followed by a footer with no prose paragraph' {
    printf 'fix: x\n\n- a\n\nRefs: #1\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'starts with bullets'
}

@test 'accepts a footer after the prose paragraph and a subject with a footer only' {
    printf 'fix: x\n\nWhy.\n\nRefs: #1\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'fix: x\n\nRefs: #1\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts a footer-looking line as the final paragraph' {
    printf 'fix: x\n\nWhy.\n\nNote: see the docs\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'rejects a footer-looking paragraph that is not the last' {
    printf 'fix: x\n\nWhy.\n\nNote: see the docs\n\n- a\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'opens a footer before the end'
}

@test 'rejects two footer paragraphs' {
    printf 'fix: x\n\nWhy.\n\nRefs: #1\n\nReviewed-by: Z\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'opens a footer before the end'
}

@test 'accepts a body that is a single footer-looking paragraph' {
    printf 'fix: x\n\nRefs: #1\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts a multi-line BREAKING CHANGE as the whole body' {
    printf 'feat!: x\n\nBREAKING CHANGE: api removed and\n  callers must migrate\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts a footer continuation after a blank run before the footer' {
    printf 'feat!: x\n\n\nBREAKING CHANGE: a\n  b\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'collapses runs of blank lines between paragraphs' {
    printf 'fix: x\n\n\nWhy.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'fix: x\n\nWhy.\n\n\n- a\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'fix: x\n\nWhy.\n\n\nRefs: #1\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'rejects indentation in a body paragraph that is not a footer' {
    printf 'fix: x\n\n\nWhy.\n  indented\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 5 is indented'
}

# --- Footers ---------------------------------------------------------------

@test 'accepts hyphenated and hash-separated footers' {
    printf 'fix: x\n\nWhy.\n\nReviewed-by: Z <z@example.com>\nRefs #123\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'rejects a footer token containing a space with a hyphen hint' {
    printf 'fix: x\n\nWhy.\n\nReviewed by: Z\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'second prose paragraph'
    assert $output contains 'Reviewed-by'
}

@test 'accepts footer tokens with digits and underscores' {
    printf 'fix: x\n\nWhy.\n\nJira-2: PROJ-1\nX_ref #3\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts a final bullet list containing a colon' {
    printf 'fix: x\n\nWhy.\n\n- Validate tokens (rules 8-9): must use hyphens\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts BREAKING CHANGE and BREAKING-CHANGE footers' {
    printf 'feat!: x\n\nWhy.\n\nBREAKING CHANGE: api removed\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    printf 'feat!: x\n\nWhy.\n\nBREAKING-CHANGE: api removed\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'accepts a multi-line BREAKING CHANGE with an indented continuation' {
    printf 'feat!: x\n\nWhy.\n\nBREAKING CHANGE: api removed and\n  callers must migrate\nRefs: #1\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

@test 'rejects a mixed-case breaking change footer' {
    printf 'feat!: x\n\nWhy.\n\nBreaking change: api removed\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains "uppercase 'BREAKING CHANGE:'"
}

# --- Skips -----------------------------------------------------------------

@test 'skips merge, fixup, squash and amend subjects' {
    local subject
    for subject in "Merge branch 'side'" 'fixup! feat: x' 'squash! feat: x' 'amend! feat: x'; do
        printf '%s\n' "$subject" >"$msg"
        run "$hook" "$msg"
        assert $state equals 0
    done
}

@test 'accepts a message with only comments' {
    printf '# Please enter the commit message\n#\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
}

# --- Rewrites --------------------------------------------------------------

@test 'strips template comment lines and writes the message back' {
    printf 'fix: x\n# Subject:\n# <type>(<scope>): <subject>\n\nWhy.\n# --- COMMIT END ---\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    [[ "$(<$msg)" == $'fix: x\n\nWhy.' ]] || fail "unexpected rewrite: $(<$msg)"
}

@test 'strips a verbose diff from the diff --git line on' {
    printf 'fix: x\n\nWhy.\n# ------------------------ >8 ------------------------\ndiff --git a/f b/f\n+added\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    [[ "$(<$msg)" == $'fix: x\n\nWhy.' ]] || fail "unexpected rewrite: $(<$msg)"
}

@test 'trims trailing whitespace and CRLF line endings' {
    printf 'fix: x  \r\n\r\nWhy. \r\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    [[ "$(<$msg)" == $'fix: x\n\nWhy.' ]] || fail "unexpected rewrite: $(<$msg)"
}

@test 'strips blank lines above the subject and writes the message back' {
    printf '\n\n  \t\nfix: x\n\nWhy.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    [[ "$(<$msg)" == $'fix: x\n\nWhy.' ]] || fail "unexpected rewrite: $(<$msg)"
}

@test 'strips blank lines left above the subject by template comments' {
    printf '# Subject:\n\nfix: x\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    [[ "$(<$msg)" == 'fix: x' ]] || fail "unexpected rewrite: $(<$msg)"
}

@test 'strips blank lines above a skipped subject' {
    printf '\nfixup! fix: x\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    [[ "$(<$msg)" == 'fixup! fix: x' ]] || fail "unexpected rewrite: $(<$msg)"
}

@test 'numbers lines from the subject after stripping leading blank lines' {
    printf '\n\nfix: x\n\nWhy.\n\n  indented\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'Line 5 is indented'
}

@test 'still requires a blank line between subject and body' {
    printf '\nfix: x\nWhy.\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert $output contains 'blank line between subject and body'
}

# --- Saved message ---------------------------------------------------------

@test 'saves a rejected editor-commit message for prepare-commit-msg' {
    printf 'Bad message\n' >"$msg"
    touch "$repo/.git/COMMIT_MSG_EDITOR"
    run "$hook" "$msg"
    assert $state equals 1
    assert "$repo/.git/COMMIT_MSG_SAVED" is_file
    assert "$(<$repo/.git/COMMIT_MSG_SAVED)" same_as 'Bad message'
}

@test 'does not save a rejected message when there is no editor marker' {
    printf 'Bad message\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    [[ ! -e "$repo/.git/COMMIT_MSG_SAVED" ]] || fail 'a non-editor message was saved'
}

@test 'keeps an existing save when a non-editor message is rejected' {
    printf 'Earlier draft\n' >"$repo/.git/COMMIT_MSG_SAVED"
    printf 'Bad message\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 1
    assert "$(<$repo/.git/COMMIT_MSG_SAVED)" same_as 'Earlier draft'
}

@test 'removes the editor marker on rejection and on success' {
    printf 'Bad message\n' >"$msg"
    touch "$repo/.git/COMMIT_MSG_EDITOR"
    run "$hook" "$msg"
    assert $state equals 1
    [[ ! -e "$repo/.git/COMMIT_MSG_EDITOR" ]] || fail 'marker survived a rejection'
    printf 'fix: x\n' >"$msg"
    touch "$repo/.git/COMMIT_MSG_EDITOR"
    run "$hook" "$msg"
    assert $state equals 0
    [[ ! -e "$repo/.git/COMMIT_MSG_EDITOR" ]] || fail 'marker survived a success'
}

@test 'clears a saved message after a successful run' {
    printf 'Old rejected message\n' >"$repo/.git/COMMIT_MSG_SAVED"
    printf 'fix: x\n' >"$msg"
    run "$hook" "$msg"
    assert $state equals 0
    [[ ! -e "$repo/.git/COMMIT_MSG_SAVED" ]] || fail 'saved message was not cleared'
}
