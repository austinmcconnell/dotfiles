#!/usr/bin/env zunit

@test 'antidote installed' {
    path=($ZDOTDIR/.antidote/ $path)
    run is-executable antidote
    assert $state equals 0
}

@test 'fd installed' {
    run is-executable fd
    assert $state equals 0
}

@test 'fzf installed' {
    run is-executable fzf
    assert $state equals 0
}

@test 'git installed' {
    run is-executable git
    assert $state equals 0
}

@test 'fnm installed' {
    run is-executable fnm
    assert $state equals 0
}

@test 'npm installed' {
    run is-executable npm
    assert $state equals 0
}

@test 'npm default packages installed' {
    local packages_file="$DOTFILES_DIR/etc/node/default-packages"
    if [[ ! -s "$packages_file" ]]; then
        assert 0 equals 0  # no packages to check
        return
    fi
    installed_packages=(${(f)"$(npm ls --global --parseable | awk '{gsub(/\/.*\//,"",$1); print}' | sort)"})
    local missing=()
    for package in $(cat "$packages_file"); do
        trimmed_package=$(echo $package | cut -d '/' -f 2 )
        if [[ ${installed_packages[(Ie)$trimmed_package]} -eq 0 ]]; then
            missing+=($package)
        fi
    done
    [[ ${#missing} -eq 0 ]] || fail "missing: ${(j:, :)missing}"
    assert ${#missing} equals 0
}

@test 'pre-commit installed' {
    run is-executable pre-commit
    assert $state equals 0
}

@test 'python installed' {
    run is-executable python
    assert $state equals 0
}

@test 'python global tools installed' {
    installed_tools=$(uv tool list 2>/dev/null | awk '{print $1}')
    local missing=()
    while IFS= read -r tool_line; do
        [[ -z "$tool_line" || "$tool_line" == \#* ]] && continue
        # Keep only the tool name: drop --with flags and [extras]
        tool=${tool_line%% *}
        tool=${tool%%\[*}
        if ! grep -qx "$tool" <<<"$installed_tools"; then
            missing+=($tool)
        fi
    done <"$DOTFILES_DIR/etc/python/uv-tools"
    [[ ${#missing} -eq 0 ]] || fail "missing: ${(j:, :)missing}"
    assert ${#missing} equals 0
}

@test 'ruby installed' {
    run is-executable ruby
    assert $state equals 0
}

@test 'rbenv installed' {
    run is-executable rbenv
    assert $state equals 0
}

@test 'ruby default gems installed' {
    installed_gems=(${(f)"$(gem list --no-versions)"})
    local missing=()
    for gem_name in $(cat $DOTFILES_DIR/etc/ruby/default-gems); do
        if [[ ${installed_gems[(Ie)$gem_name]} -eq 0 ]]; then
            missing+=($gem_name)
        fi
    done
    [[ ${#missing} -eq 0 ]] || fail "missing: ${(j:, :)missing}"
    assert ${#missing} equals 0
}

@test 'go installed' {
    run is-executable go
    assert $state equals 0
}

@test 'go default tools installed' {
    for tool in gopls goimports dlv staticcheck; do
        assert "$HOME/go/bin/$tool" is_file
        echo "$tool is installed"
    done
}

@test 'vim installed' {
    run is-executable vim
    assert $state equals 0
}
