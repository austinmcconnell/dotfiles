#!/usr/bin/env zunit

@setup {
    repo_root=${testdir:A:h}
}

@test 'zsh config files parse' {
    local -a files=(
        "$repo_root"/etc/zsh/conf.d/*.zsh*(N)
        "$repo_root"/etc/zsh/functions/*(N.)
        "$repo_root"/etc/zsh/completions/_*(N)
        "$repo_root"/etc/zsh/.z{shenv,shrc,profile,login,styles}(N)
        "$repo_root"/etc/zsh/custom/plugins/*/*.zsh(N)
    )
    assert ${#files} is_greater_than 0
    local -a broken=()
    local file
    for file in $files; do
        zsh -n "$file" 2>/dev/null || broken+=(${file:t})
    done
    [[ ${#broken} -eq 0 ]] || fail "syntax errors: ${(j:, :)broken}"
    assert ${#broken} equals 0
}
