#!/usr/bin/env zunit

@test 'verify vim version' {
    run bash -c "vim --version | head -1 | cut -d ' ' -f 5 | cut -d '.' -f 1"
    assert $output is_greater_than 7
}

@test 'verify python default links to a uv-managed interpreter' {
    run readlink "${XDG_DATA_HOME:-$HOME/.local/share}/python/default/bin/python3"
    assert $output contains /uv/python/cpython-
}

@test 'verify ruby version matches default' {
    DEFAULT_RUBY_VERSION=$(grep '^DEFAULT_RUBY_VERSION=' install/ruby.sh | cut -d '=' -f 2 | tr -d '"')
    run ruby --version
    assert $output contains "$DEFAULT_RUBY_VERSION"
}

@test 'verify go version' {
    run bash -c "go version | grep -oE '[0-9]+\.[0-9]+' | head -1 | cut -d '.' -f 1"
    assert $output is_greater_than 0
}

@teardown {
    if [[ -n "${python_implicit_tmp:-}" ]]; then
        rm -rf "$python_implicit_tmp"
    fi
}

@test 'uv has every interpreter the installer lists' {
    local -a missing=()
    local version
    for version in ${=$(sed -n 's/^UV_PYTHON_VERSIONS=(\(.*\))$/\1/p' "$DOTFILES_DIR/install/python.sh")}; do
        uv python find "$version" >/dev/null 2>&1 || missing+=("$version")
    done
    [[ ${#missing} -eq 0 ]] || fail "missing: ${(j:, :)missing}"
    assert ${#missing} equals 0
}

@test 'python-implicit resolves a .python-version pin via uv' {
    python_implicit_tmp=$(mktemp -d)
    local cache_dir="$python_implicit_tmp/cache"
    local pin_dir="$python_implicit_tmp/pinned"
    local unpinned_dir="$python_implicit_tmp/unpinned"
    mkdir -p "$pin_dir" "$unpinned_dir"
    print -r -- 3.13 >"$pin_dir/.python-version"

    run env XDG_CACHE_HOME="$cache_dir" zsh -c 'source "$1"; cd "$2"; command -v python3' zsh "$DOTFILES_DIR/etc/zsh/conf.d/python.zsh" "$pin_dir"
    assert $output contains python-implicit

    run env XDG_CACHE_HOME="$cache_dir" zsh -c 'source "$1"; cd "$2"; command -v python3' zsh "$DOTFILES_DIR/etc/zsh/conf.d/python.zsh" "$unpinned_dir"
    assert $output does_not_contain python-implicit
}
