#!/usr/bin/env zunit

@setup {
    repo_root=${testdir:A:h}
}

@test 'verify vim version' {
    run bash -c "vim --version | head -1 | cut -d ' ' -f 5 | cut -d '.' -f 1"
    assert $output is_greater_than 7
}

@test 'verify python default links to a uv-managed interpreter' {
    run readlink "${XDG_DATA_HOME:-$HOME/.local/share}/python/default/bin/python3"
    assert $output contains /uv/python/cpython-
}

@test 'verify ruby version matches default' {
    DEFAULT_RUBY_VERSION=$(grep '^DEFAULT_RUBY_VERSION=' "$repo_root/install/ruby.sh" | cut -d '=' -f 2 | tr -d '"')
    assert "$DEFAULT_RUBY_VERSION" is_not_empty
    run ruby --version
    assert $output contains "$DEFAULT_RUBY_VERSION"
}

@test 'verify go version' {
    run bash -c "go version | grep -oE '[0-9]+\.[0-9]+' | head -1 | cut -d '.' -f 1"
    assert $output is_greater_than 0
}

@teardown {
    if [[ -n "${python_implicit_tmp:-}" ]]; then
        rm -rf "$python_implicit_tmp"
    fi
}

@test 'uv has every interpreter the installer lists' {
    local line=$(grep '^UV_PYTHON_VERSIONS=(.*)$' "$repo_root/install/python.sh")
    assert "$line" is_not_empty
    local -a versions=(${=${${line#*\(}%\)}})
    [[ ${#versions} -gt 0 ]] || skip "UV_PYTHON_VERSIONS in install/python.sh is empty"
    local -a missing=()
    local version
    for version in $versions; do
        uv python find "$version" >/dev/null 2>&1 || missing+=("$version")
    done
    [[ ${#missing} -eq 0 ]] || fail "missing: ${(j:, :)missing}"
    assert ${#missing} equals 0
}

@test 'python-implicit links each pin to its own interpreter' {
    python_implicit_tmp=$(mktemp -d)
    local cache_dir="$python_implicit_tmp/cache"
    local pin_313="$python_implicit_tmp/pin-313"
    local pin_311="$python_implicit_tmp/pin-311"
    local unpinned_dir="$python_implicit_tmp/unpinned"
    mkdir -p "$pin_313" "$pin_311" "$unpinned_dir"
    print -r -- 3.13 >"$pin_313/.python-version"
    print -r -- 3.11 >"$pin_311/.python-version"

    run env XDG_CACHE_HOME="$cache_dir" zsh -f -c 'source "$1"; cd "$2"; cd "$3"; readlink "$4/3.13/python3"; readlink "$4/3.11/python3"' zsh "$repo_root/etc/zsh/conf.d/python.zsh" "$pin_313" "$pin_311" "$cache_dir/zsh/python-implicit"
    assert $output contains cpython-3.13-
    assert $output contains cpython-3.11-

    run env XDG_CACHE_HOME="$cache_dir" zsh -f -c 'source "$1"; cd "$2"; command -v python3' zsh "$repo_root/etc/zsh/conf.d/python.zsh" "$pin_311"
    assert $output contains python-implicit/3.11/python3

    run env XDG_CACHE_HOME="$cache_dir" zsh -f -c 'source "$1"; cd "$2"; command -v python3' zsh "$repo_root/etc/zsh/conf.d/python.zsh" "$unpinned_dir"
    assert $output does_not_contain python-implicit
}
