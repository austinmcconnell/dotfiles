#!/usr/bin/env zunit

@setup {
    fpath=(${testdir:A:h}/etc/zsh/functions $fpath)
    autoload -Uz calc get_trunk_branch git
}

@teardown {
    if [[ -n "${stub_dir:-}" ]]; then
        rm -rf "$stub_dir"
    fi
    if [[ -n "${trunk_repo:-}" ]]; then
        rm -rf "$trunk_repo"
    fi
}

@test 'calc' {
    run calc 1 + 2
    assert $output same_as 3
}

@test 'get_trunk_branch' {
    local tree commit
    trunk_repo=$(mktemp -d)
    git -C "$trunk_repo" init --quiet
    tree=$(git -C "$trunk_repo" mktree </dev/null)
    commit=$(git -C "$trunk_repo" -c user.name=zunit -c user.email=zunit@example.com commit-tree "$tree" -m init)
    git -C "$trunk_repo" update-ref refs/remotes/origin/trunk "$commit"
    git -C "$trunk_repo" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/trunk

    cd "$trunk_repo"
    run get_trunk_branch
    assert $output same_as trunk
}

@test 'git checkout blocked' {
    stub_dir=$(mktemp -d)
    printf '#!/bin/sh\ntouch "%s/called"\n' "$stub_dir" >"$stub_dir/git"
    chmod +x "$stub_dir/git"
    path=($stub_dir $path)

    run git checkout main
    assert $state equals 1
    assert $output contains "Don't use checkout"
    [[ ! -e "$stub_dir/called" ]] || fail "git checkout reached the real git"
}
