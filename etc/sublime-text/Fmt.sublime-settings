{
    "rules": [
        {
            "selector": "source.json",
            "cmd": ["dprint", "fmt", "--stdin", "$file"],
            "format_on_save": true,
            "merge_type": "diff"
        },
        {
            "selector": "source.yaml",
            "cmd": ["dprint", "fmt", "--stdin", "$file"],
            "format_on_save": true,
            "merge_type": "diff"
        },
        {
            "selector": "text.html.markdown",
            "cmd": [
                "zsh",
                "-lc",
                "cd \"$HOME\" && \"$PYENV_ROOT/versions/$(cat \"$PYENV_ROOT/version\")/bin/mdformat\" - | rumdl fmt --silent -"
            ],
            "format_on_save": true,
            "merge_type": "diff"
        },
        {
            "selector": "source.shell",
            "cmd": ["shfmt", "--indent", "4"],
            "format_on_save": true,
            "merge_type": "diff"
        },
        {
            "selector": "source.terraform",
            "cmd": ["terraform", "fmt", "-"],
            "format_on_save": true,
            "merge_type": "diff"
        },
        {
            "selector": "source.toml",
            "cmd": ["taplo", "format", "--config", "~/.dotfiles/etc/taplo/taplo.toml", "-"],
            "format_on_save": true,
            "merge_type": "diff"
        }
    ]
}
