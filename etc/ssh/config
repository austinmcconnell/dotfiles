# Base SSH Configuration
# Machine-specific configs are in hosts.d/

# Include machine-specific configurations (must come before Host * for precedence)
Include ~/.ssh/hosts.d/*.conf

# Global settings
Host *
    IgnoreUnknown UseKeychain
    UseKeychain yes
    AddKeysToAgent yes
    IdentitiesOnly yes
    ControlMaster auto
    # Hashed ControlPath (%C = hash of local host + remote host + port +
    # user + jump host). macOS caps Unix-domain socket paths at ~104 bytes;
    # a literal user@fqdn:port path overflows for long FQDNs mid-master-setup.
    # The hash is fixed-length and still yields a distinct socket per
    # host+user+port, so sessions to different hosts never share a master.
    ControlPath ~/.ssh/controlmasters/%C
    ControlPersist 4h
    TCPKeepAlive no
    ServerAliveInterval 60
    ServerAliveCountMax 30
