#!/bin/bash

set -euo pipefail

# Validates commit messages against conventional commits format.
# Skips validation for git-generated Merge/Squash subjects and for fixup!,
# squash!, and amend! subjects. A plain `git commit --amend` is validated.
# Bypassed with --no-verify (e.g., the wip alias uses this).

COMMIT_MSG_FILE="$1"

# Save a rejected message so prepare-commit-msg can restore it next time, but
# only for editor commits: prepare-commit-msg leaves a marker for those. The
# marker is removed on every exit so it cannot outlive this commit attempt, and
# an accepted message clears any pending save.
GIT_DIR_PATH="$(git rev-parse --git-dir)"
SAVED_MSG="$GIT_DIR_PATH/COMMIT_MSG_SAVED"
EDITOR_MARKER="$GIT_DIR_PATH/COMMIT_MSG_EDITOR"

finish() {
    local ec=$?
    if [[ $ec -eq 0 ]]; then
        rm -f "$SAVED_MSG"
    elif [[ -f "$EDITOR_MARKER" ]]; then
        cp "$COMMIT_MSG_FILE" "$SAVED_MSG"
    fi
    rm -f "$EDITOR_MARKER"
}
trap finish EXIT

# Configuration
PREFIX="[commit-msg]"
MAX_SUBJECT_LENGTH=72
MAX_BODY_LINE_LENGTH=72
VALID_TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
footer_token="^([A-Za-z0-9_-]+|BREAKING CHANGE)(: | #)"

# Strip comments (lines starting with #) and verbose diff output.
# With commit.verbose=true, git appends the diff below a scissor line
# (# --- >8 ---) or below the comment block. Strip both.
message=$(sed '/^#/d; /^diff --git /,$d' "$COMMIT_MSG_FILE")

# Trim trailing whitespace from each line.
# ${var//} doesn't support [[:space:]] or $
# shellcheck disable=SC2001
message=$(echo "$message" | sed 's/[[:space:]]*$//')

# Write cleaned message back so git uses the trimmed version.
echo "$message" >"$COMMIT_MSG_FILE"

# Get the subject line (first non-empty line)
subject=$(echo "$message" | sed '/^$/d' | head -1)

# Skip empty messages (git will abort these anyway)
if [[ -z "$subject" ]]; then
    exit 0
fi

# Skip merge, fixup, squash, and amend commits
skip_pattern="^(Merge |Squash |fixup!|squash!|amend!)"
if [[ "$subject" =~ $skip_pattern ]]; then
    exit 0
fi

# Group the body into paragraphs: runs of non-blank lines after the subject
# separator. Runs of blank lines collapse, which matters because the commit
# template leaves them. para_start and para_first hold each paragraph's first
# line number and text. Both the indent check and the body check use them.
para_start=()
para_first=()
in_para=false
line_num=0
while IFS= read -r line; do
    line_num=$((line_num + 1))
    if [[ $line_num -le 2 ]]; then
        continue
    fi
    if [[ -z "$line" ]]; then
        in_para=false
    elif [[ "$in_para" == false ]]; then
        para_start+=("$line_num")
        para_first+=("$line")
        in_para=true
    fi
done <<<"$message"
para_count=${#para_start[@]}

# footer_start is the line a footer block begins on, or 0 when the final
# paragraph does not open with a footer token. Bullets are body text even
# when they match the token pattern ("- #42 ..."). A body that is only a footer
# counts, so a multi-line BREAKING CHANGE keeps its indented continuation.
footer_start=0
if [[ $para_count -gt 0 ]]; then
    last_para=$((para_count - 1))
    if [[ "${para_first[$last_para]}" != "- "* && "${para_first[$last_para]}" =~ $footer_token ]]; then
        footer_start=${para_start[$last_para]}
    fi
fi

# Check: every line starts at column 0. Indentation is allowed only for bullet
# continuations (their exact width is checked below) and for the lines of a
# footer block. Pasted or accidentally indented text is rejected, not fixed.
in_bullet=false
line_num=0
while IFS= read -r line; do
    line_num=$((line_num + 1))
    if [[ -z "$line" ]]; then
        in_bullet=false
        continue
    fi
    if [[ "$line" != [[:space:]]* ]]; then
        in_bullet=false
        if [[ "$line" == "- "* ]]; then
            in_bullet=true
        fi
        continue
    fi
    if [[ "$in_bullet" == true ]]; then
        continue
    fi
    if [[ $footer_start -gt 0 && $line_num -ge $footer_start ]]; then
        continue
    fi
    echo "$PREFIX Line $line_num is indented; lines must start at column 0." >&2
    echo "" >&2
    echo "  $line" >&2
    echo "" >&2
    echo "Only bullet continuations (2 spaces) and footer values may be indented." >&2
    exit 1
done <<<"$message"

# Pattern: type(scope)!: subject  or  type!: subject  or  type: subject
# Lowercase types only — spec rule 15 says case-insensitive, but that targets
# parsers, not authoring tools. Matches commitlint and ecosystem conventions.
conv_pattern="^($VALID_TYPES)(\([a-zA-Z0-9-]+\))?\!?: .+"

if ! [[ "$subject" =~ $conv_pattern ]]; then
    echo "$PREFIX Invalid commit message format." >&2
    echo "" >&2
    echo "  $subject" >&2
    echo "" >&2
    echo "Expected: type(scope): description" >&2
    echo "Types: ${VALID_TYPES//|/, }" >&2
    echo "Example: feat(auth): add OAuth2 login support" >&2
    exit 1
fi

# Extract the description (text after ": ")
description="${subject#*: }"

# Check: no period at end
if [[ "$description" == *. ]]; then
    echo "$PREFIX Subject must not end with a period." >&2
    echo "" >&2
    echo "  $subject" >&2
    exit 1
fi

# Check: lowercase after colon
first_char="${description:0:1}"
if [[ "$first_char" =~ [A-Z] ]]; then
    echo "$PREFIX Description must start with lowercase." >&2
    echo "" >&2
    echo "  $subject" >&2
    exit 1
fi

# Check: subject length
if [[ ${#subject} -gt $MAX_SUBJECT_LENGTH ]]; then
    echo "$PREFIX Subject is ${#subject} chars (max $MAX_SUBJECT_LENGTH)." >&2
    echo "" >&2
    echo "  $subject" >&2
    exit 1
fi

# Check: blank line between subject and body
second_line=$(echo "$message" | sed -n '2p')
if [[ -n "$second_line" ]]; then
    echo "$PREFIX Must have a blank line between subject and body." >&2
    exit 1
fi

# Check: body lines wrapped at 72 chars
line_num=0
while IFS= read -r line; do
    line_num=$((line_num + 1))
    # Skip subject and blank separator
    if [[ $line_num -le 2 ]]; then
        continue
    fi
    if [[ ${#line} -gt $MAX_BODY_LINE_LENGTH ]]; then
        echo "$PREFIX Body line $line_num is ${#line} chars (max $MAX_BODY_LINE_LENGTH)." >&2
        echo "" >&2
        echo "  $line" >&2
        exit 1
    fi
done <<<"$message"

# Check: bullet continuation lines must be indented 2 spaces.
# A continuation is a non-blank line that follows a "- " bullet (or another
# continuation) and doesn't start a new bullet or footer.
# NOTE: the gitcommit ftplugin (etc/vim/after/ftplugin/gitcommit.vim) mirrors
# this in_bullet state machine and the indent check above to highlight
# violations live. Change one, change both.
in_bullet=false
line_num=0
while IFS= read -r line; do
    line_num=$((line_num + 1))
    if [[ $line_num -le 2 ]]; then
        continue
    fi
    if [[ -z "$line" ]]; then
        in_bullet=false
        continue
    fi
    if [[ "$line" == "- "* ]]; then
        in_bullet=true
        continue
    fi
    if [[ "$in_bullet" == true ]]; then
        # Require exactly 2 spaces: flag under-indented (<2) and over-indented
        # (3+) continuations alike. A valid continuation starts with "  " and
        # the third character is not whitespace (so "  <tab>" is rejected).
        if ! [[ "$line" =~ ^\ \ [^[:space:]] ]]; then
            echo "$PREFIX Bullet continuation must be indented exactly 2 spaces." >&2
            echo "" >&2
            echo "  $line" >&2
            echo "" >&2
            echo "Example:" >&2
            echo "  - First line of bullet" >&2
            echo "    continuation indented 2 spaces" >&2
            exit 1
        fi
    fi
done <<<"$message"

# Check: BREAKING CHANGE footer must be uppercase (conventional commits spec)
bad_breaking_change="^[Bb][Rr][Ee][Aa][Kk][Ii][Nn][Gg][ -][Cc][Hh][Aa][Nn][Gg][Ee]:"
good_breaking_change="^BREAKING[ -]CHANGE:"
while IFS= read -r line; do
    if [[ "$line" =~ $bad_breaking_change ]] && ! [[ "$line" =~ $good_breaking_change ]]; then
        echo "$PREFIX Use uppercase 'BREAKING CHANGE:' (conventional commits spec)." >&2
        echo "" >&2
        echo "  $line" >&2
        exit 1
    fi
done <<<"$message"

# Check: body structure. A body is one prose paragraph, then any number of
# "- " bullet paragraphs, then an optional footer paragraph. A footer opens with
# "Token: value" or "Token #value" (conventional commits spec rules 8-9), and a
# token is one word using - for spaces (exception: BREAKING CHANGE). Any other
# paragraph is a second prose paragraph. Messages stay short because of this.
# NOTE: the gitcommit ftplugin mirrors this classifier to highlight violations
# live. Change one, change both.
hash_separator=" #"
if [[ $para_count -gt 0 && "${para_first[0]}" == "- "* ]]; then
    echo "$PREFIX Line ${para_start[0]} starts with bullets; open the body with a paragraph." >&2
    echo "" >&2
    echo "  ${para_first[0]}" >&2
    echo "" >&2
    echo "Explain why the change was made, then list what changed in bullets." >&2
    exit 1
fi
for ((i = 1; i < para_count; i++)); do
    first="${para_first[$i]}"
    if [[ "$first" == "- "* ]]; then
        continue
    fi
    if [[ "$first" =~ $footer_token ]]; then
        if [[ $i -eq $((para_count - 1)) ]]; then
            continue
        fi
        echo "$PREFIX Line ${para_start[$i]} opens a footer before the end of the message." >&2
        echo "" >&2
        echo "  $first" >&2
        echo "" >&2
        echo "Footers are one paragraph at the end, one per line." >&2
        exit 1
    fi
    echo "$PREFIX Line ${para_start[$i]} starts a second prose paragraph." >&2
    echo "" >&2
    echo "  $first" >&2
    echo "" >&2
    echo "A body is one prose paragraph, then '- ' bullets, then an optional footer." >&2
    if [[ "$first" =~ ": " ]] || [[ "$first" =~ $hash_separator ]]; then
        echo "If this line is a footer, its token must be one word or hyphenated" >&2
        echo "(Reviewed-by: Z, Refs #12) and it must be the last paragraph." >&2
    fi
    exit 1
done
