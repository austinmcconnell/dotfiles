#!/bin/bash

# This hook runs after git checkout operations, including after a clone
# $1 - the ref of the previous HEAD
# $2 - the ref of the new HEAD
# $3 - flag indicating if it's a branch checkout (1) or a file checkout (0)

# If this is a clone operation, $1 will be all zeros
if [ "$1" = "0000000000000000000000000000000000000000" ]; then
    # Skip repos in cache, plugin, or temp directories (macOS resolves /tmp to /private/tmp)
    REPO_DIR="$(git rev-parse --show-toplevel)"
    case "$REPO_DIR" in
    "$HOME/.cache/"* | "$HOME/.vim/"* | "$HOME/sources/"* | /tmp/* | /private/tmp/* | \
        /private/var/folders/*)
        exit 0
        ;;
    esac

    # Linked worktrees share the main repo's refs and maintenance registration
    git_dir="$(git rev-parse --path-format=absolute --git-dir)"
    common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
    if [[ "${git_dir}" != "${common_dir}" ]]; then
        exit 0
    fi

    # Check if we have a remote named origin
    if git remote | grep -q "^origin$"; then
        echo "Setting up origin/HEAD reference..."
        git remote set-head origin -a
    fi

    # Register for scheduled maintenance
    MAINTENANCE_CONFIG="$HOME/.config/git/config-maintenance"
    if [ -f "$MAINTENANCE_CONFIG" ]; then
        git maintenance register --config-file "$MAINTENANCE_CONFIG"
        echo "Registered repository for scheduled maintenance."
    fi
fi

exit 0
